# ─── Core Django Configuration ────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database (PostgreSQL with pgvector) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=neuronrunner
DB_USER=postgres
DB_PASSWORD=postgres

# ─── Redis (Channels & Cache) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Docker Sandbox Runtime ───────────────────────────────────────────────────
SANDBOX_PROVIDER=docker
DOCKER_SANDBOX_IMAGE=neuronrunner-sandbox:latest
DOCKER_SANDBOX_FALLBACK_IMAGE=python:3.11-slim
LOCAL_WORKSPACE_ROOT=/app/workspaces
PREVIEW_PROXY_BASE_URL=http://127.0.0.1:8090
PREVIEW_PROXY_PORT=8090

# ─── Encryption (Optional dedicated Fernet key for BYOK vault) ────────────────
WORKSPACE_KEYS_ENCRYPTION_KEY=

# ─── LLMs ─────────────────────────────────────────────────────────────────────
# Chat never uses server keys: every workspace connects its own API key or
# subscription on the /hello page. The keys below only serve memory embeddings
# and the admin model-catalog tools.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
TAVILY_API_KEY=

# ─── Optional Memory Embeddings (leave blank to use full-text search) ─────────
MEMORY_EMBEDDING_MODEL=

# ─── Optional OAuth & Email ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# ─── Optional Cloudflare Turnstile Bot Protection ─────────────────────────────
TURNSTILE_REQUIRED=False
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
